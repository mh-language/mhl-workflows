use {Codex as codex, CodexWithoutSchema as codex_without_schema, CodexResultParser as parser} from "codex.agent.mh"

export tool CodexAdapter {
    // Executes a query using the Codex agent and returns the result.
    execute(prompt, schema_path: string) -> {
        try {
            var raw = codex.run(prompt: prompt, schema: schema_path)
            return parser.parse(raw)
        } catch (e) {
            log.error("[dev] failed to execute codex query: ${e}")
            return null
        }
    }

    execute_without_schema(prompt) -> {
        try {
            var raw = codex_without_schema.run(prompt: prompt)
            return parser.parse(raw)
        } catch (e) {
            log.error("[dev] failed to execute codex query: ${e}")
            return null
        }
    }   
}