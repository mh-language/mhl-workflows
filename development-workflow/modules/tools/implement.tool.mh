export tool ImplementTool {
    get_feature_context(feature: object) : string -> {
        
        var context = {
            RequirementItems: feature.implementationContext.requirements,
            DecisionItems: feature.implementationContext.decisions,
            ConstraintItems: feature.implementationContext.constraints,
            FileItems: feature.implementationContext.files,
            AcceptanceItems: feature.implementationContext.acceptance
        }

        return """
        requirements: ${context.RequirementItems}
        decisions: ${context.DecisionItems}
        constraints: ${context.ConstraintItems}
        files: ${context.FileItems}
        acceptance: ${context.AcceptanceItems}
        """
    }

    get_design_context() : string -> {
        var design_doc_path = self.get_candidates_paths(config.docs_folder())
            .filter((path) -> fs.exists(path))

        var design_context = fs.read(design_doc_path[0])

        return design_context.replace("\r\n", "\\n").replace("\n", "\\n")
    }

    get_candidates_paths(docsFolder: string) : string[] -> {

        var raw = [
            "${docsFolder}/20-software-design-document.md",
            "${docsFolder}/active/20-software-design-document.md",
            "specs/active/20-software-design-document.md"
        ]
        var unique = []
        for (var path in raw) {
            if (!unique.contains(path)) {
                unique = unique + [path]
            }
        }
        return unique
    }
}