import { Digest as digest } from "digest.tool.mh"

// Namespaced store for the Specification flow's own artifacts, under
// .mhl/specification/ — the MHL counterpart of dotnet/Flows.Specification's
// SpecificationStore (.harness/specification/active/). Deliberately separate
// from the Development workflow's .mhl/feature_list.json so an approved bundle's
// history survives past handoff and is never wiped by an unrelated run.
//
// Every documental phase follows the same two-file convention:
//   <phase>.proposal.json  — the driver's not-yet-validated draft
//   <phase>.accepted.json   — the version that passed its evaluator (canonical)
//
// MHL forbids assigning to a nested field, so run state is always rebuilt as a
// whole object literal rather than mutated in place.
//memory RunMemory { type: "json" path: ".mhl/specification/run.json" }

// Run state now lives in Postgres via the store-postgres extension instead of a
// local run.json. Session isolation is done at the *key* level (see run_key()):
// every row is written under "<session_id>/run", so two concurrent runs — or a
// fresh run vs. a --resume of an older one — never touch the same row.
//
// NOTE: only ONE `extension store` declaration is allowed per project (`mhl
// serve` refuses more than one) — this is it; main.mh no longer declares its own.
extension store_specs RunMemory {
    dsn: env("DATABASE_URL")
    table: "mhl_spec_store"
}

type RunState = {
    step: number,
    status: string,
    phase: string,
    recascades: number,
    terminalReason: any
}

export tool SpecStore {
    // Current run's session id, folded into every path and store key so runs
    // stay isolated. Falls back to "default" when there is no `context:` block
    // in scope (e.g. a direct `mhl test` of this tool) — the workflow that
    // drives the pipeline must declare `context: { ... }` for this to resolve.
    session() : string -> {
        try {
            var s = context.session_id
            if (s != null && s != "") { return s }
        } catch (e) {
            return "default"
        }
        return "default"
    }

    // Per-session store key namespace — mirrors dir() on the Postgres side.
    run_key() : string -> self.session() + "/run"

    dir() : string -> ".mhl/specification/" + self.session()

    proposal_path(phase: string) : string -> self.dir() + "/" + phase + ".proposal.json"
    accepted_path(phase: string) : string -> self.dir() + "/" + phase + ".accepted.json"
    manifest_path() : string -> self.dir() + "/publish-manifest.json"

    // --- run state -----------------------------------------------------------

    default_run() : RunState -> {
        return {
            step: 0,
            status: "in_progress",
            phase: "discover",
            recascades: 0,
            terminalReason: null
        }
    }

    has_run() : boolean -> RunMemory.get(self.run_key()) != null

    field(obj: any, name: string, fallback: any) : any -> {
        try {
            if (obj != null && obj.keys().contains(name)) { return obj[name] }
        } catch (e) {
            return fallback
        }
        return fallback
    }

    load_run() : RunState -> {
        var run = RunMemory.get(self.run_key())
        if (run == null) { return self.default_run() }
        return {
            step: self.field(run, "step", 0),
            status: self.field(run, "status", "in_progress"),
            phase: self.field(run, "phase", "discover"),
            recascades: self.field(run, "recascades", 0),
            terminalReason: self.field(run, "terminalReason", null)
        }
    }

    // store-postgres exposes the `store` contract verbs get / put / delete /
    // list — not the `memory` block's get / set.
    save_run(run: RunState) -> RunMemory.put(self.run_key(), run)

    begin() -> RunMemory.put(self.run_key(), self.default_run())

    // Advance to the next in-progress phase (bumps the step counter, blueprint
    // 0004 §4 "step, status, phase, counters").
    set_phase(phase: string) -> {
        var run = self.load_run()
        self.save_run({
            step: run.step + 1,
            status: "in_progress",
            phase: phase,
            recascades: run.recascades,
            terminalReason: run.terminalReason
        })
    }

    // Blueprint 0004 §2 lists "awaiting_approval" as a real status value — the
    // run pauses here for the human approval gate.
    await_approval() -> {
        var run = self.load_run()
        self.save_run({
            step: run.step + 1,
            status: "awaiting_approval",
            phase: "approve",
            recascades: run.recascades,
            terminalReason: run.terminalReason
        })
    }

    terminate(status: string, reason: string) -> {
        var run = self.load_run()
        self.save_run({
            step: run.step,
            status: status,
            phase: run.phase,
            recascades: run.recascades,
            terminalReason: reason
        })
        log.warn("[spec] run terminal: ${status} — ${reason}")
    }

    complete() -> {
        var run = self.load_run()
        self.save_run({
            step: run.step,
            status: "completed",
            phase: "stop",
            recascades: run.recascades,
            terminalReason: run.terminalReason
        })
    }

    // Current run status string ("in_progress" | "awaiting_approval" |
    // "completed" | "publish_blocked" | "needs_human_decision").
    status() : string -> self.load_run().status

    is_terminal() : boolean -> {
        var s = self.load_run().status
        return s == "completed" || s == "publish_blocked" || s == "needs_human_decision"
    }

    is_resumable() : boolean -> {
        if (!self.has_run()) { return false }
        var s = self.load_run().status
        return s == "in_progress" || s == "awaiting_approval"
    }

    recascade_count() : number -> self.load_run().recascades

    bump_recascade() -> {
        var run = self.load_run()
        self.save_run({
            step: run.step,
            status: run.status,
            phase: run.phase,
            recascades: run.recascades + 1,
            terminalReason: run.terminalReason
        })
    }

    // --- recascade feedback ----------------------------------------------
    //
    // review can send the run back to product / analysis / design. Without this
    // the recascaded phase re-runs its prompt with no idea why it was rejected
    // and tends to reproduce the same document until the recascade cap trips.
    // review drops its conflicts / residuals here; the target phase consumes
    // them once as its first retry_block.
    recascade_note_path() : string -> self.dir() + "/recascade.note.txt"

    write_recascade_note(text: string) -> fs.write(self.recascade_note_path(), text)

    consume_recascade_note() : string -> {
        var path = self.recascade_note_path()
        try {
            if (!fs.exists(path)) { return "" }
            var text = fs.read(path)
            fs.delete(path)
            return text
        } catch (e) {
            return ""
        }
    }

    // --- documents ---------------------------------------------------------

    read_proposal(phase: string) : object -> {
        var path = self.proposal_path(phase)
        try {
            if (!fs.exists(path)) { return null }
            return json.parse(fs.read(path))
        } catch (e) {
            log.error("[spec] failed to read proposal ${path}: ${e}")
            return null
        }
    }

    read_accepted(phase: string) : object -> {
        var path = self.accepted_path(phase)
        try {
            if (!fs.exists(path)) { return null }
            return json.parse(fs.read(path))
        } catch (e) {
            log.error("[spec] failed to read accepted ${path}: ${e}")
            return null
        }
    }

    // Persist the evaluator-passed version and return its content digest — the
    // value later phases compare against (ideaDigest, prdDigest, srsDigest,
    // bundleDigest) to reject a stale parent.
    accept(phase: string, value: any) : string -> {
        var path = self.accepted_path(phase)
        fs.write(path, json.stringify(value))
        return digest.file(path)
    }

    accepted_digest(phase: string) : string -> {
        var value = self.read_accepted(phase)
        if (value == null) { return "" }
        return digest.of(value)
    }

    // Digest of the whole accepted chain (idea -> prd -> srs -> sdd -> readiness),
    // in that fixed order — what ApprovalDecision.bundleDigest must match. Any
    // accepted phase changing after the approval preview changes this value.
    bundle_digest() : string -> {
        var parts = [
            self.accepted_digest("idea"),
            self.accepted_digest("prd"),
            self.accepted_digest("srs"),
            self.accepted_digest("sdd"),
            self.accepted_digest("readiness")
        ]
        var joined = ""
        for (var p in parts) {
            joined = if (joined == "") p else joined + "|" + p
        }
        return digest.text(joined)
    }

    // Clear every proposal/accepted file for this session's run — a fresh start.
    // Run state itself lives in Postgres, so drop that key too, then remove the
    // now-empty session directory.
    reset() -> {
        try { RunMemory.delete(self.run_key()) } catch (e) {
            log.warn("[spec] reset: could not delete run key ${self.run_key()}: ${e}")
        }

        var files = [
            "sources.accepted.json", ".digest.tmp",
            "idea.proposal.json", "idea.accepted.json",
            "prd.proposal.json", "prd.accepted.json",
            "srs.proposal.json", "srs.accepted.json",
            "sdd.proposal.json", "sdd.accepted.json",
            "review.proposal.json", "readiness.accepted.json",
            "approval.proposal.json", "publish-manifest.json",
            "recascade.note.txt"
        ]
        for (var f in files) {
            var path = self.dir() + "/" + f
            try {
                if (fs.exists(path)) { fs.delete(path) }
            } catch (e) {
                log.warn("[spec] reset: could not delete ${path}: ${e}")
            }
        }

        try {
            if (fs.exists(self.dir())) { fs.delete(self.dir()) }
        } catch (e) {
            log.warn("[spec] reset: could not remove session dir ${self.dir()}: ${e}")
        }
    }
}
