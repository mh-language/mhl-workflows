import { SpecConfig as config } from "spec-config.tool.mh"
import { SpecEvaluatorCommon as common } from "spec-evaluator-common.tool.mh"

export tool IdeaEvaluator {
    schema() : string -> "iao/idea/v1"

    evaluate(idea: object, source: string, source_digest: string) : object -> {
        if (idea == null) {
            return common.result(["IDEA_PROPOSAL_MISSING: the idea proposal is missing or not valid JSON"])
        }
        if (!is_object(idea)) {
            return common.result(["IDEA_PROPOSAL_INVALID: the idea proposal must be a JSON object"])
        }

        var v = []
        v += common.array_type_violation(idea?.users, "users", "IDEA_USERS_INVALID")
        v += common.array_type_violation(idea?.desiredOutcomes, "desiredOutcomes", "IDEA_OUTCOMES_INVALID")
        v += common.array_type_violation(idea?.openQuestions, "openQuestions", "IDEA_OPEN_QUESTIONS_INVALID")

        if (common.str(idea?.schema) != self.schema()) v += ["IDEA_SCHEMA_UNKNOWN: expected schema " + self.schema() + ", got " + common.str(idea?.schema)]
        if (common.blank(idea?.title)) v += ["IDEA_TITLE_MISSING: title is required"]
        if (common.blank(idea?.problem)) v += ["IDEA_PROBLEM_MISSING: problem is required"]
        if (common.list(idea?.users).is_empty()) v += ["IDEA_USERS_MISSING: at least one user is required"]
        if (common.list(idea?.desiredOutcomes).is_empty()) v += ["IDEA_OUTCOMES_MISSING: at least one desired outcome is required"]
        
        v = common.dup_violations(v, common.ids_of(common.list(idea?.openQuestions)), "IDEA_OPEN_QUESTION_DUPLICATE_ID", "open question")
        
        if (json.stringify(idea).size() > config.max_idea_chars()) {
            v += ["IDEA_TOO_LARGE: idea exceeds the canonical character limit"]
        }

        if (common.blank(source)) v += ["IDEA_SOURCE_MISSING: source is required"]
        if (common.blank(source_digest)) v += ["IDEA_DIGEST_MISSING: source digest is required"]
        
        return common.result(v)
    }
}
