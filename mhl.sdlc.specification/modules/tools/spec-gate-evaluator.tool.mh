import { SpecEvaluatorCommon as common } from "spec-evaluator-common.tool.mh"
import { ReadinessEvaluator as readiness } from "readiness-evaluator.tool.mh"

export tool SpecGateEvaluator {
    evaluate_development_readiness(prd: object, srs: object, sdd: object, readiness_value: object, rendered: object, docs_max_chars: number) : object -> {
        var v = []
        var blocking = []
        for (var q in common.list(prd?.openQuestions)) if (q?.blocking == true) blocking += [q?.id]
        if (!blocking.is_empty()) {
            v += ["DEV_READINESS_BLOCKING_QUESTION_OPEN: unresolved blocking open question(s): " + blocking.join(", ")]
        }
        var readiness_result = readiness.evaluate(readiness_value, common.requirement_ids(srs), common.adr_ids(sdd))
        for (var rv in readiness_result.violations) v += [rv]
        var total = 0
        for (var key in rendered?.keys() ?? []) total = total + rendered[key].size()
        if (total > docs_max_chars) {
            v += ["DEV_READINESS_BUNDLE_TOO_LARGE: rendered bundle exceeds the docsMaxChars ceiling"]
        }
        return common.result(v)
    }
}
