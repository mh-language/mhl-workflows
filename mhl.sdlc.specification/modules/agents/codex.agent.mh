// Codex CLI backing for the Specification flow. The driver writes each phase's
// proposal to a real JSON file with its own file-write tool; this agent just
// carries the prompt and hands back the last agent message for logging. No
// output schema is used — the harness gate is the deterministic evaluator, not a
// structured response.
export agent Codex {
    engine: "cli/codex"
    command: "codex"
    log: ".mhl/logs/codex_${context.session_id}.log" 
    //log: ".mhl/logs/codex.log"
    args: [
        "exec",
        "--approve-for-me",
        "--json",
        "--",
        "${prompt}"
    ]

    retry: {
        max_attempts: 3
        delay: 5s
    }

    after: () -> {
        return CodexResultParser.parse(result)
    }
}

export tool CodexResultParser {
    parse(raw: string) : string -> {
        try {
            var events = json.parse_lines(raw)
            var completed = events.filter((e) -> e.type == "item.completed")
            var messages = completed.filter((e) -> e.item.type == "agent_message")
            if (messages.size() == 0) {
                return raw
            }
            return messages[messages.size() - 1].item.text
        } catch (e) {
            log.warn("[spec] could not parse Codex JSON events; preserving raw result: ${e}")
            return raw
        }
    }
}
