use { SpecEvaluatorCommon as common } from "spec-evaluator-common.tool.mh"
use { IdeaEvaluator as idea } from "idea-evaluator.tool.mh"
use { PrdEvaluator as prd } from "prd-evaluator.tool.mh"
use { SrsEvaluator as srs } from "srs-evaluator.tool.mh"
use { SddEvaluator as sdd } from "sdd-evaluator.tool.mh"
use { ReadinessEvaluator as readiness } from "readiness-evaluator.tool.mh"
use { SpecGateEvaluator as gate } from "spec-gate-evaluator.tool.mh"

// Compatibility facade for the specification workflow. Document rules live
// in focused evaluators; shared defensive helpers live in SpecEvaluatorCommon.
// Existing callers can keep importing SpecEvaluator unchanged.
export tool SpecEvaluator {
    IDEA_SCHEMA() : string -> idea.schema()
    PRD_SCHEMA() : string -> prd.schema()
    SRS_SCHEMA() : string -> srs.schema()
    SDD_SCHEMA() : string -> sdd.schema()

    f(obj: any, name: string) : any -> common.f(obj, name)
    str(value: any) : string -> common.str(value)
    list(value: any) : any[] -> common.list(value)
    result(violations: string[]) : object -> common.result(violations)
    blank(value: any) : boolean -> common.blank(value)
    dup_ids(ids: any[]) : any[] -> common.dup_ids(ids)
    ids_of(items: any[]) : any[] -> common.ids_of(items)
    requirement_ids(srs_value: object) : any[] -> common.requirement_ids(srs_value)
    adr_ids(sdd_value: object) : any[] -> common.adr_ids(sdd_value)
    join_violations(violations: string[]) : string -> common.join_violations(violations)
    retry_block(violations: string[]) : string -> common.retry_block(violations)
    dup_violations(v: any[], ids: any[], code: string, kind: string) : any[] -> common.dup_violations(v, ids, code, kind)

    evaluate_idea(value: object, source: string, source_digest: string) : object -> idea.evaluate(value, source, source_digest)
    evaluate_prd(value: object, current_idea_digest: string) : object -> prd.evaluate(value, current_idea_digest)
    evaluate_srs(value: object, current_prd_digest: string, accepted_goal_ids: any[]) : object -> srs.evaluate(value, current_prd_digest, accepted_goal_ids)
    evaluate_sdd(value: object, current_srs_digest: string, requirement_ids: any[], current_source_digest: string, current_source_files: any[]) : object -> sdd.evaluate(value, current_srs_digest, requirement_ids, current_source_digest, current_source_files)
    evaluate_readiness(value: object, known_requirement_ids: any[], known_adr_ids: any[]) : object -> readiness.evaluate(value, known_requirement_ids, known_adr_ids)
    evaluate_approval(value: object, current_bundle_digest: string) : object -> gate.evaluate_approval(value, current_bundle_digest)
    evaluate_development_readiness(prd_value: object, srs_value: object, sdd_value: object, readiness_value: object, approval_digest: string, current_digest: string, rendered: object, docs_max_chars: number) : object -> gate.evaluate_development_readiness(prd_value, srs_value, sdd_value, readiness_value, approval_digest, current_digest, rendered, docs_max_chars)
}
