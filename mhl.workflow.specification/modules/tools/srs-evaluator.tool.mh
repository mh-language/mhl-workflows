use { SpecEvaluatorCommon as common } from "spec-evaluator-common.tool.mh"

export tool SrsEvaluator {
    schema() : string -> "iao/srs/v1"

    evaluate(srs: object, current_prd_digest: string, accepted_goal_ids: any[]) : object -> {
        if (srs == null) {
            return common.result(["SRS_PROPOSAL_MISSING: the SRS proposal is missing or not valid JSON"])
        }
        var v = []
        if (common.str(srs?.schema) != self.schema()) {
            v += ["SRS_SCHEMA_UNKNOWN: expected schema " + self.schema() + ", got " + common.str(srs?.schema)]
        }
        if (current_prd_digest == "" || common.str(srs?.prdDigest) != current_prd_digest) {
            v += ["SRS_PRD_DIGEST_STALE: srs.prdDigest " + common.str(srs?.prdDigest) + " does not match the current accepted PRD digest " + current_prd_digest]
        }

        var requirements = []
        for (var r in common.list(srs?.functionalRequirements)) requirements += [r]
        for (var r in common.list(srs?.qualityRequirements)) requirements += [r]
        var req_ids = common.ids_of(requirements)
        v = common.dup_violations(v, req_ids, "SRS_REQUIREMENT_ID_DUPLICATE", "requirement")

        var ac_ids = common.ids_of(common.list(srs?.acceptanceCriteria))
        var covered_goals = []
        for (var r in requirements) {
            for (var g in common.list(r?.goalIds)) covered_goals += [g]
        }
        for (var gid in common.list(accepted_goal_ids)) {
            if (!covered_goals.contains(gid)) {
                v += ["SRS_GOAL_NOT_COVERED: goal ${gid} is not covered by any requirement"]
            }
        }

        for (var r in requirements) {
            var rid = common.str(r?.id)
            if (common.blank(r?.statement)) v += ["SRS_REQUIREMENT_STATEMENT_MISSING: requirement " + rid + " has no statement"]
            if (common.list(r?.acceptanceIds).is_empty()) v += ["SRS_REQUIREMENT_WITHOUT_ACCEPTANCE: requirement " + rid + " has no acceptance criterion"]
            for (var aid in common.list(r?.acceptanceIds)) {
                if (!ac_ids.contains(aid)) {
                    v += ["SRS_ACCEPTANCE_REFERENCE_DANGLING: requirement ${rid} references unknown acceptance criterion ${aid}"]
                }
            }
            for (var dep in common.list(r?.dependsOn)) {
                if (!req_ids.contains(dep)) {
                    v += ["SRS_REQUIREMENT_DEPENDENCY_DANGLING: requirement ${rid} depends on unknown requirement ${dep}"]
                }
            }
        }

        for (var ac in common.list(srs?.acceptanceCriteria)) {
            var acid = common.str(ac?.id)
            if (common.blank(ac?.given) || common.blank(ac?.when) || common.blank(ac?.then)) {
                v += ["SRS_ACCEPTANCE_CRITERION_TEXT_MISSING: acceptance criterion " + acid + " has an empty given/when/then"]
            }
            for (var acr in common.list(ac?.requirementIds)) {
                if (!req_ids.contains(acr)) {
                    v += ["SRS_ACCEPTANCE_CRITERION_REQUIREMENT_DANGLING: acceptance criterion ${acid} references unknown requirement ${acr}"]
                }
            }
        }

        for (var iface in common.list(srs?.interfaces)) {
            var ifid = common.str(iface?.id)
            if (common.blank(iface?.name) || common.blank(iface?.description)) {
                v += ["SRS_INTERFACE_TEXT_MISSING: interface " + ifid + " has an empty name or description"]
            }
            for (var ir in common.list(iface?.requirementIds)) {
                if (!req_ids.contains(ir)) {
                    v += ["SRS_INTERFACE_REQUIREMENT_DANGLING: interface ${ifid} references unknown requirement ${ir}"]
                }
            }
        }

        for (var dr in common.list(srs?.dataRules)) {
            var drid = common.str(dr?.id)
            if (common.blank(dr?.rule)) v += ["SRS_DATA_RULE_TEXT_MISSING: data rule " + drid + " has no rule text"]
            for (var drr in common.list(dr?.requirementIds)) {
                if (!req_ids.contains(drr)) {
                    v += ["SRS_DATA_RULE_REQUIREMENT_DANGLING: data rule ${drid} references unknown requirement ${drr}"]
                }
            }
        }

        var delivery = srs?.delivery
        if (delivery == null) {
            v += ["SRS_DELIVERY_MISSING: delivery must be an object"]
        } else {
            if (common.blank(delivery?.target) || common.blank(delivery?.verificationStrategy)) {
                v += ["SRS_DELIVERY_TEXT_MISSING: delivery contract has an empty target or verification strategy"]
            }
        }
        return common.result(v)
    }
}
