use { SpecConfig as config } from "spec-config.tool.mh"
use { SpecEvaluatorCommon as common } from "spec-evaluator-common.tool.mh"

export tool ReadinessEvaluator {
    evaluate(verdict: object, known_requirement_ids: any[], known_adr_ids: any[]) : object -> {
        if (verdict == null) {
            return common.result(["READINESS_PROPOSAL_MISSING: the readiness verdict proposal is missing or not valid JSON"])
        }
        var v = []
        var word = common.str(verdict?.verdict)
        var allowed = ["READY", "FAIL:product", "FAIL:analysis", "FAIL:design"]
        if (!allowed.contains(word)) {
            v += ["READINESS_VERDICT_INVALID: verdict ${word} is not one of READY, FAIL:product, FAIL:analysis, FAIL:design"]
        }
        if (verdict?.conflicts == null) v += ["READINESS_CONFLICTS_MISSING: conflicts must be an array (use [] when there are none)"]
        if (verdict?.residuals == null) v += ["READINESS_RESIDUALS_MISSING: residuals must be an array (use [] when there are none)"]
        if (word != "READY") return common.result(v)

        var slices = common.list(verdict?.slices)
        if (slices.is_empty()) v += ["READINESS_SLICES_EMPTY: a READY verdict requires at least one readiness slice"]
        if (slices.size() > config.max_slices()) {
            v += ["READINESS_TOO_MANY_SLICES: slice count exceeds the cap"]
        }

        var slice_ids = common.ids_of(slices)
        v = common.dup_violations(v, slice_ids, "READINESS_SLICE_ID_DUPLICATE", "readiness slice")
        var known_req = common.list(known_requirement_ids)
        var known_adr = common.list(known_adr_ids)
        for (var s in slices) {
            var sid = common.str(s?.id)
            for (var rid in common.list(s?.requirementIds)) {
                if (!known_req.contains(rid)) {
                    v += ["READINESS_REQUIREMENT_REFERENCE_DANGLING: slice ${sid} references unknown requirement ${rid}"]
                }
            }
            for (var aid in common.list(s?.adrIds)) {
                if (!known_adr.contains(aid)) {
                    v += ["READINESS_ADR_REFERENCE_DANGLING: slice ${sid} references unknown ADR ${aid}"]
                }
            }
            for (var dep in common.list(s?.dependsOn)) {
                if (dep == s?.id || !slice_ids.contains(dep)) {
                    v += ["READINESS_DEPENDENCY_REFERENCE_DANGLING: slice ${sid} depends on unknown or self-referencing slice ${dep}"]
                }
            }
        }
        if (self.has_cycle(slices)) v += ["READINESS_DEPENDENCY_CYCLE: the slice dependsOn graph contains a cycle"]

        var has_initial = false
        for (var s in slices) if (common.list(s?.dependsOn).is_empty()) has_initial = true
        if (!slices.is_empty() && !has_initial) {
            v += ["READINESS_NO_INITIAL_SLICE: at least one slice must have an empty dependsOn (an initial slice)"]
        }

        var covered = []
        for (var s in slices) {
            for (var rid in common.list(s?.requirementIds)) covered += [rid]
        }
        for (var rid in known_req) {
            if (!covered.contains(rid)) {
                v += ["READINESS_REQUIREMENT_NOT_SLICED: requirement ${rid} is not covered by any readiness slice"]
            }
        }
        return common.result(v)
    }

    has_cycle(slices: any[]) : boolean -> {
        var ids = common.ids_of(slices)
        var resolved = []
        var changed = true
        var remaining = []
        for (var s in common.list(slices)) remaining += [s]
        while (changed == true) {
            changed = false
            var next_remaining = []
            for (var s in remaining) {
                var unmet = []
                for (var dep in common.list(s?.dependsOn)) {
                    if (dep != s?.id && ids.contains(dep) && !resolved.contains(dep)) unmet += [dep]
                }
                if (unmet.is_empty()) {
                    resolved += [s?.id]
                    changed = true
                } else {
                    next_remaining += [s]
                }
            }
            remaining = next_remaining
        }
        return remaining.size() > 0
    }
}
