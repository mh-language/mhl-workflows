use { Digest as digest } from "../modules/tools/digest.tool.mh"
use { SpecStore as store } from "../modules/tools/spec-store.tool.mh"
use { SpecPublisher as publisher } from "../modules/tools/spec-publisher.tool.mh"

// Exercises the I/O-backed helpers: sha256 shell-out, the namespaced accepted
// store, digest-chain freshness, and the development-plan builder.
// Run: mhl test tests/io_test.mh

test digest_is_deterministic_and_content_addressed {
    describe same_value_same_digest {
        var a = digest.of({ b: 2, a: 1 })
        var b = digest.of({ a: 1, b: 2 })
        are_equal(a, b)
        is_true(a.starts_with("sha256:"))
    }

    describe different_value_different_digest {
        not_equal(digest.of({ a: 1 }), digest.of({ a: 2 }))
    }
}

test accepted_store_round_trip {
    describe accept_then_read_and_digest_chain {
        store.reset()
        store.begin()

        var idea = { schema: "iao/idea/v1", title: "t" }
        var d1 = store.accept("idea", idea)
        is_true(d1.starts_with("sha256:"))

        var back = store.read_accepted("idea")
        are_equal(back.title, "t")
        are_equal(store.accepted_digest("idea"), d1)

        // Re-accepting a changed idea changes the digest (staleness signal).
        var d2 = store.accept("idea", { schema: "iao/idea/v1", title: "t2" })
        not_equal(d1, d2)

        store.reset()
    }

    describe run_state_transitions {
        store.reset()
        store.begin()
        are_equal(store.load_run().phase, "discover")
        is_false(store.is_terminal())

        store.set_phase("product")
        are_equal(store.load_run().phase, "product")

        store.bump_recascade()
        are_equal(store.recascade_count(), 1)

        store.terminate("needs_human_decision", "test")
        is_true(store.is_terminal())
        store.reset()
    }
}

test development_plan_shape {
    describe one_feature_per_slice_with_dev_workflow_fields {
        var srs = {
            functionalRequirements: [{ id: "RF-1", statement: "do a thing" }],
            qualityRequirements: [],
            acceptanceCriteria: [{ id: "AC-1", requirementIds: ["RF-1"], given: "g", when: "w", then: "t" }],
            interfaces: [],
            dataRules: [],
            delivery: { target: "app/x", verificationStrategy: "tests", isBootstrap: true }
        }
        var sdd = { adrs: [{ id: "ADR-1", title: "T", decision: "D", rationale: "R", requirementIds: ["RF-1"] }], controls: [] }
        var readiness = {
            verdict: "READY", conflicts: [], residuals: [],
            slices: [{
                id: "SL-1", classification: "greenfield", goal: "ship RF-1",
                inScope: ["a"], outOfScope: ["b"], observableOutcome: "o",
                requirementIds: ["RF-1"], adrIds: ["ADR-1"], dependsOn: [], contracts: [],
                happyPath: "h", failurePath: "f", acceptanceCriterion: "ac",
                suggestedTarget: "app/x/Feature.cs", suggestedVerificationStrategy: "unit"
            }]
        }
        var plan = publisher.build_development_plan(srs, sdd, readiness)
        are_equal(plan.features.size(), 1)
        var f = plan.features[0]
        are_equal(f.id, 1)
        are_equal(f.status, "pending")
        is_true(f.references.contains("RF-1"))
        is_true(f.references.contains("ADR-1"))
        is_true(f.implementationContext.files.contains("app/x/Feature.cs"))
    }
}
