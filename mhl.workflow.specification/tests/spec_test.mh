use { SpecEvaluator as evaluator } from "../modules/tools/spec-evaluator.tool.mh"
use { SpecRenderer as renderer } from "../modules/tools/spec-renderer.tool.mh"

// Focused checks for the pure, I/O-free parts of the Specification flow — the
// evaluators (blueprint 0004 §5) and the accepted-JSON -> Markdown renderer
// (§4). Run: mhl test tests/spec_test.mh

test idea_evaluator {
    describe accepts_a_well_formed_idea {
        var idea = {
            schema: "iao/idea/v1",
            title: "Task API",
            problem: "teams track work in spreadsheets",
            users: ["team lead"],
            desiredOutcomes: ["one source of truth"],
            constraints: [],
            openQuestions: []
        }
        var res = evaluator.evaluate_idea(idea, "specs/sources (charter.md)", "sha256:abc")
        is_true(res.passed)
    }

    describe rejects_missing_fields_and_bad_schema {
        var idea = {
            schema: "wrong/schema",
            title: "",
            problem: "x",
            users: [],
            desiredOutcomes: [],
            openQuestions: [{ id: "OQ-1" }, { id: "OQ-1" }]
        }
        var res = evaluator.evaluate_idea(idea, "", "")
        is_false(res.passed)
        // schema, title, users, outcomes, dup id, source, digest
        is_true(res.violations.size() >= 6)
    }

    describe rejects_a_null_proposal {
        var res = evaluator.evaluate_idea(null, "driver", "sha256:x")
        is_false(res.passed)
    }

    describe tolerates_a_proposal_with_omitted_fields {
        // An LLM proposal that leaves out whole keys must fail cleanly, not crash.
        var res = evaluator.evaluate_idea({ schema: "iao/idea/v1" }, "driver", "sha256:x")
        is_false(res.passed)
        is_true(res.violations.size() >= 3)
    }
}

test srs_evaluator_tolerates_sparse_items {
    describe data_rule_without_a_rule_field_is_a_violation_not_a_crash {
        var srs = {
            schema: "iao/srs/v1",
            prdDigest: "sha256:P",
            functionalRequirements: [{ id: "RF-1", goalIds: ["G-1"], statement: "s", dependsOn: [], acceptanceIds: ["AC-1"] }],
            qualityRequirements: [],
            acceptanceCriteria: [{ id: "AC-1", requirementIds: ["RF-1"], given: "g", when: "w", then: "t" }],
            interfaces: [],
            dataRules: [{ id: "DR-1", requirementIds: ["RF-1"] }],
            delivery: { target: "app/x", verificationStrategy: "tests", isBootstrap: true }
        }
        var res = evaluator.evaluate_srs(srs, "sha256:P", ["G-1"])
        is_false(res.passed)
        is_true(evaluator.join_violations(res.violations).contains("SRS_DATA_RULE_TEXT_MISSING"))
    }
}

test prd_evaluator {
    describe rejects_stale_idea_digest_and_conflated_metric {
        var prd = {
            schema: "iao/prd/v1",
            ideaDigest: "sha256:STALE",
            vision: "v",
            goals: [{ id: "G-1", statement: "s" }],
            successMetrics: [{ id: "M-1", goalId: "G-1", measure: "same", target: "same" }],
            nonGoals: ["ng"],
            scope: ["sc"],
            risks: [],
            decisions: [],
            openQuestions: [{ id: "Q-1", blocking: true }]
        }
        var res = evaluator.evaluate_prd(prd, "sha256:CURRENT")
        is_false(res.passed)
        // digest stale + measure/target not separate + blocking question
        is_true(res.violations.size() >= 3)
    }

    describe accepts_a_consistent_prd {
        var prd = {
            schema: "iao/prd/v1",
            ideaDigest: "sha256:CURRENT",
            vision: "v",
            goals: [{ id: "G-1", statement: "s" }],
            successMetrics: [{ id: "M-1", goalId: "G-1", measure: "cycle time", target: "< 2 days" }],
            nonGoals: ["ng"],
            scope: ["sc"],
            risks: [],
            decisions: [],
            openQuestions: []
        }
        var res = evaluator.evaluate_prd(prd, "sha256:CURRENT")
        is_true(res.passed)
    }
}

test readiness_evaluator {
    describe detects_a_dependency_cycle_and_incomplete_cover {
        var verdict = {
            verdict: "READY",
            conflicts: [],
            residuals: [],
            slices: [
                { id: "SL-1", requirementIds: ["RF-1"], adrIds: [], dependsOn: ["SL-2"] },
                { id: "SL-2", requirementIds: ["RF-1"], adrIds: [], dependsOn: ["SL-1"] }
            ]
        }
        var res = evaluator.evaluate_readiness(verdict, ["RF-1", "RF-2"], [])
        is_false(res.passed)
        // cycle + no initial slice + RF-2 not sliced
        is_true(res.violations.size() >= 3)
    }

    describe accepts_an_acyclic_complete_cover {
        var verdict = {
            verdict: "READY",
            conflicts: [],
            residuals: [],
            slices: [
                { id: "SL-1", goal: "g1", observableOutcome: "o1", acceptanceCriterion: "a1", suggestedTarget: "src/one", suggestedVerificationStrategy: "tests", requirementIds: ["RF-1"], adrIds: ["ADR-1"], dependsOn: [] },
                { id: "SL-2", goal: "g2", observableOutcome: "o2", acceptanceCriterion: "a2", suggestedTarget: "src/two", suggestedVerificationStrategy: "tests", requirementIds: ["RF-2"], adrIds: [], dependsOn: ["SL-1"] }
            ]
        }
        var res = evaluator.evaluate_readiness(verdict, ["RF-1", "RF-2"], ["ADR-1"])
        is_true(res.passed)
    }

    describe fail_verdict_skips_slice_checks {
        var verdict = { verdict: "FAIL:design", conflicts: ["c"], residuals: [], slices: [] }
        var res = evaluator.evaluate_readiness(verdict, ["RF-1"], [])
        is_true(res.passed)
    }
}

test renderer_is_deterministic_and_escapes {
    describe prd_render_is_stable {
        var prd = {
            vision: "ship *fast*",
            goals: [{ id: "G-1", statement: "a" }],
            successMetrics: [],
            nonGoals: ["n"],
            scope: ["s"],
            risks: [],
            decisions: [],
            openQuestions: []
        }
        var a = renderer.render_prd(prd)
        var b = renderer.render_prd(prd)
        are_equal(a, b)
        is_true(a.contains("# Product Requirements Document"))
        is_true(a.contains("ship \\*fast\\*"))
    }

    describe renders_a_sparse_document_without_crashing {
        var a = renderer.render_prd({ goals: [{ id: "G-1" }] })
        is_true(a.contains("## Vision"))
        is_true(a.contains("**G-1:**"))
        var s = renderer.render_srs({})
        is_true(s.contains("## Delivery"))
    }
}
