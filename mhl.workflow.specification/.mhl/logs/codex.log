undle exists\"]\nmodules/tools/sdd-evaluator.tool.mh:72:            } else if (!common.list(sdd?.sourceFiles).deep_equal(common.list(current_source_files))) {\nmodules/tools/sdd-evaluator.tool.mh:73:                v += [\"SDD_SOURCE_FILES_STALE: sdd.sourceFiles does not match the current accepted source bundle\"]\nmodules/tools/spec-evaluator.tool.mh:5:use { SddEvaluator as sdd } from \"sdd-evaluator.tool.mh\"\nmodules/tools/spec-evaluator.tool.mh:25:    requirement_ids(srs_value: object) : any[] -> common.requirement_ids(srs_value)\nmodules/tools/spec-evaluator.tool.mh:34:    evaluate_sdd(value: object, current_srs_digest: string, requirement_ids: any[], current_source_digest: string, current_source_files: any[]) : object -> sdd.evaluate(value, current_srs_digest, requirement_ids, current_source_digest, current_source_files)\nmodules/tools/spec-evaluator.tool.mh:35:    evaluate_readiness(value: object, known_requirement_ids: any[], known_adr_ids: any[]) : object -> readiness.evaluate(value, known_requirement_ids, known_adr_ids)\nmodules/tools/spec-evaluator-common.tool.mh:45:    requirement_ids(srs: object) : any[] -> {\nmodules/tools/spec-gate-evaluator.tool.mh:31:        var readiness_result = readiness.evaluate(readiness_value, common.requirement_ids(srs), common.adr_ids(sdd))\n","exit_code":0,"status":"completed"}}
