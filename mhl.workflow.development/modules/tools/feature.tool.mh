use { RunConfig as config } from "run-config.tool.mh"

memory Memory { type: "json" path: ".mhl/feature_list.json" }
memory ObsMemory { type: "json" path: ".mhl/plan_observations.json" }

type Feature = {
    id: number,
    title: string,
    priority: number,
    dependsOn: number[],
    description: string,
    references: string[],
    implementationContext: object,
    status: string
}

export tool FeatureStore {
    // Get the list of features from memory
    get() : Feature[] -> Memory.get("features", []) ?? []

    // Set the list of features in memory
    set(features: Feature[]) -> Memory.set("features", features)

    // Check if there are any pending features
    has_pending_features() : boolean -> {
        const features = self.get()
        return features.any((f) -> f.status == "pending")
    }

    // Mark a feature as done by id, persisting the updated list
    mark_done(id: number) : boolean -> {
        const features = self.get()

        var updated = false
        var result = []
        for (var f in features) {
            const status = if (f.id == id) "completed" else f.status
            if (f.id == id) {
                updated = true
            }
            result += [
            {
                "id": f.id,
                "description": f.description,
                "references": f.references,
                "implementationContext": f.implementationContext,
                "title": f.title,
                "priority": f.priority,
                "dependsOn": f.dependsOn,
                "status": status
            }]
        }

        if (!updated) {
            log.info("[dev] mark_done: feature ${id} not found in store.")
            return false
        }

        self.set(result)
        log.info("[dev] Feature ${id} marked as done.")
        return true
    }

    // Accept a parsed development-plan object ({"features":[...]}), cap it to
    // max_features (preserving the dependency closure) and persist. Mirrors
    // import_from without the file read; used by the Plan step's Codex fallback.
    set_plan(plan) : boolean -> {
        if (plan == null) return false

        const raw = self.extract_features(plan)
        if (raw.is_empty()) {
            log.info("[dev] set_plan: parsed plan had no 'features' array.")
            return false
        }

        if (!self.validate_features(raw)) {
            log.info("[dev] set_plan: feature list failed structural validation.")
            return false
        }

        const capped = self.cap_features(raw, config.max_features())
        if (capped.is_empty()) {
            log.info("[dev] set_plan: feature list was empty after capping.")
            return false
        }

        self.set(capped)
        return true
    }

    pick_next_feature() : object -> {
        const features = self.get()

        const passed_ids = features
            .filter((f) -> self.is_completed(f.status))
            .map((f) -> f.id)

        const ready = features
            .filter((f) -> f.status == "pending" && (f.dependsOn ?? []).all((d) -> passed_ids.contains(d)))
            .sort_by((f) -> f.priority * 1000000 + f.id)

        return if (ready.is_empty()) null else ready[0]
    }

    // Reset the feature store by clearing features, observations and plan files
    reset() -> {
        Memory.set("features", null)
        ObsMemory.set("observations", null)
        self.reset_plan()
    }

    // reset_plan deletes the plan / revision-proposal files to reset the feature store
    reset_plan() -> {
        for (var planfile in [".mhl/plan_revision.json"]) {
            try {
                if (fs.exists(planfile)) {
                    log.info("[dev] Deleting plan file: ${planfile}")
                    fs.delete(planfile)
                }
            } catch (e) {
                log.error("[dev] failed to clear ${planfile}: ${e}")
            }
        }
    }

    // Try to import a preview plan
    try_import_preview_plan() : boolean -> {
        const candidates = config.get_document_candidates("40-development-plan.json")

        var i = 0
        var found = false
        var result = false
        while (i < candidates.size() && !found) {
            if (fs.exists(candidates[i])) {
                const outcome = self.import_from(candidates[i], config.max_features())
                if (outcome) {
                    found = true
                    result = true
                }
            }
            i = i + 1
        }
        return result
    }    

    // Import features from a given path, capping the number of features to maxFeatures
    import_from(path: string, maxFeatures: number) : boolean -> {

        try {
            const raw = fs.read(path)
            const plan = json.parse(raw)
            const raw_features = self.extract_features(plan)
            if (!self.validate_features(raw_features)) {
                log.info("[dev] published handoff '${path}' was invalid.")
                return false
            }
            const features = self.cap_features(raw_features, maxFeatures)
            if (features.is_empty()) {
                log.info("[dev] published handoff '${path}' was invalid or empty.")
                return false
            }
            FeatureStore.set(features)
            return true
        } catch (err) {
            log.error("[dev] failed to import published handoff '${path}': ${err}")
            return false
        }
    }  

    // Cap the number of features to maxFeatures without cutting required dependencies.
    cap_features(features: Feature[], maxFeatures: number) : Feature[] -> {
        if (maxFeatures <= 0) return []

        const sorted = features.sort_by((f) -> f.priority * 1000000 + f.id)
        var capped = sorted[..maxFeatures]

        var capped_ids = []
        for (var f in capped) {
            capped_ids += [f.id]
        }

        // Expand the selection to include every transitive prerequisite. If the
        // configured cap cannot contain the closure, fail closed rather than
        // making a feature appear independent of its prerequisite.
        var changed = true
        while (changed) {
            changed = false
            for (var f in capped) {
                for (var dep in f.dependsOn ?? []) {
                    if (!capped_ids.contains(dep)) {
                        const dependency = features.find((candidate) -> candidate.id == dep)
                        if (dependency == null) return []
                        capped += [dependency]
                        capped_ids += [dep]
                        changed = true
                    }
                }
            }
        }

        if (capped.size() > maxFeatures) return []

        var result = []
        for (var f in capped) {
            result += [
            {
                "id": f.id, 
                "description": f.description,
                "references": f.references,
                "implementationContext": f.implementationContext,
                "title": f.title, 
                "priority": f.priority, 
                "dependsOn": f.dependsOn ?? [],
                "status": "pending"
            }]
        }
        return result
    } 

    // --- Plan revision (replan) ----------------------------------------------

    // Append a plan observation; returns its generated id (OBS-N).
    record_observation(kind: string, feature_id, summary: string, evidence: string) : string -> {
        var existing = ObsMemory.get("observations", null) ?? []
        const n = existing.size() + 1
        const obs_id = "OBS-${n}"
        const entry = {
            "id": obs_id,
            "kind": kind,
            "feature_id": feature_id,
            "summary": summary,
            "evidence": evidence
        }
        existing += [entry]
        ObsMemory.set("observations", existing)
        return obs_id
    }

    // Accept both the canonical object form and the legacy array form while
    // normalizing every imported plan into the same internal representation.
    extract_features(plan: any) : Feature[] -> {
        return if (is_array(plan)) plan else (plan?.features ?? [])
    }

    is_completed(status: string) : boolean ->
        // Accept the old persisted token during migration, but only emit
        // "completed" from this workflow.
        status == "completed" || status == "done"

    validate_features(features: Feature[]) : boolean -> {
        if (features == null || features.is_empty()) return false

        var ids = []
        for (var f in features) {
            if (!is_object(f) || f.id == null || f.id <= 0 || f.id % 1 != 0) return false
            if (ids.contains(f.id)) return false
            if (f.title == null || f.description == null || f.priority == null) return false
            if (f.dependsOn != null && !is_array(f.dependsOn)) return false
            ids += [f.id]
        }

        for (var f in features) {
            for (var dep in f.dependsOn ?? []) {
                if (!ids.contains(dep) || dep == f.id) return false
            }
        }

        return !self.has_cycle(features)
    }

    // Human-readable list of recorded observations for the replan prompt.
    get_observations_text() : string -> {
        var existing = ObsMemory.get("observations", null)
        if (existing?.is_empty() ?? true) {
            return "(no observations recorded)"
        }
        return existing.map((o) -> "${o.id} [${o.kind}] feature=${o.feature_id}: ${o.summary}; evidence=${o.evidence}").join("\n") + "\n"
    }

    // Returns true when the dependsOn graph has a cycle (Kahn's algorithm:
    // repeatedly drop nodes whose dependencies are all resolved).
    has_cycle(features: object[]) : boolean -> {
        var remaining = []
        for (var f in features) {
            remaining += [f]
        }

        var resolved = []
        var changed = true
        while (changed) {
            changed = false
            var next_remaining = []
            for (var r in remaining) {
                const deps = r.dependsOn ?? []
                const unmet = deps.filter((d) -> !resolved.contains(d))
                if (unmet.is_empty()) {
                    resolved += [r.id]
                    changed = true
                } else {
                    next_remaining += [r]
                }
            }
            remaining = next_remaining
        }

        return remaining.size() > 0
    }

    // Validate a driver-proposed plan revision and, if valid, replace the plan.
    // revision = { reason, alternativesConsidered, basedOnObservationIds, revisedFeatures }
    // Returns { success: boolean, error: string }.
    apply_revision(revision) : object -> {
        if (revision == null) {
            return {"success": false, "error": "no revision object"}
        }
        var proposed = revision?.revisedFeatures ?? []
        if (proposed.is_empty()) {
            return {"success": false, "error": "revisedFeatures is missing or empty"}
        }

        // 1. ids present, positive and unique
        var seen = []
        for (var f in proposed) {
            if (f.id == null || f.id <= 0) {
                return {"success": false, "error": "every feature needs a positive integer id"}
            }
            if (seen.contains(f.id)) {
                return {"success": false, "error": "duplicate feature id ${f.id}"}
            }
            seen += [f.id]
        }

        // 2. every already-completed feature must survive the revision
        const current = self.get()
        var done_ids = []
        for (var c in current) {
            if (self.is_completed(c.status)) {
                done_ids += [c.id]
            }
        }
        for (var d in done_ids) {
            if (!seen.contains(d)) {
                return {"success": false, "error": "revision drops already-completed feature ${d}"}
            }
        }

        // 3. dependsOn must reference known ids, no self-deps, no cycles
        for (var f in proposed) {
            const deps = f.dependsOn ?? []
            for (var dep in deps) {
                if (dep == f.id) {
                    return {"success": false, "error": "feature ${f.id} depends on itself"}
                }
                if (!seen.contains(dep)) {
                    return {"success": false, "error": "feature ${f.id} depends on unknown id ${dep}"}
                }
            }
        }
        if (self.has_cycle(proposed)) {
            return {"success": false, "error": "dependency graph has a cycle"}
        }

        // 4. normalize: completed features stay completed, everything else pending
        var normalized = []
        for (var f in proposed) {
            const status = if (done_ids.contains(f.id)) "completed" else "pending"
            normalized += [
            {
                "id": f.id,
                "description": f.description,
                "references": f.references ?? [],
                "implementationContext": f.implementationContext,
                "title": f.title,
                "priority": f.priority,
                "dependsOn": f.dependsOn ?? [],
                "status": status
            }]
        }

        // 5. cap to max_features (completed first, then by priority), sanitize deps
        const ordered = normalized
            .sort_by((f) -> f.priority * 1000 + f.id)
            .sort_by((f) -> if (self.is_completed(f.status)) 0 else 1)
        const capped = ordered[..config.max_features()]

        const kept_ids = capped.map((f) -> f.id)
        for (var d in done_ids) {
            if (!kept_ids.contains(d)) {
                return {"success": false, "error": "too many features; completed feature ${d} would be cut"}
            }
        }

        var final = []
        for (var f in capped) {
            for (var dep in f.dependsOn) {
                if (!kept_ids.contains(dep)) {
                    return {"success": false, "error": "feature ${f.id} would lose dependency ${dep} at max_features"}
                }
            }
            final += [
            {
                "id": f.id,
                "description": f.description,
                "references": f.references,
                "implementationContext": f.implementationContext,
                "title": f.title,
                "priority": f.priority,
                "dependsOn": f.dependsOn,
                "status": f.status
            }]
        }

        self.set(final)
        return {"success": true, "error": ""}
    }

    // Where the driver writes its revision proposal for the replan step.
    revision_proposal_path() : string -> ".mhl/plan_revision.json"

    // Drop a stale proposal so it can't satisfy the next replan attempt.
    clear_revision_proposal() -> {
        const path = self.revision_proposal_path()
        try {
            if (fs.exists(path)) {
                fs.delete(path)
            }
        } catch (e) {
            log.warn("[dev] could not clear ${path}: ${e}")
        }
    }

    // Current persisted feature list as raw JSON, for the replan prompt.
    current_plan_json() : string -> {
        const path = ".mhl/feature_list.json"
        return if (fs.exists(path)) fs.read(path) else "(no plan on disk)"
    }

    // Load the driver-written revision file and apply it. Returns { success, error }.
    apply_revision_file() : object -> {
        const path = self.revision_proposal_path()
        if (!fs.exists(path)) {
            return {"success": false, "error": "Codex did not write ${path}"}
        }
        const revision = json.parse(fs.read(path))
        const outcome = self.apply_revision(revision)
        if (outcome.success) {
            log.info("[dev] Applied plan revision: ${revision.reason}")
        }
        return outcome
    }

    // Read all files in the source folder and concatenate their contents into a single string
    read_files_in_source_folder(path: string) : string -> {
        const files = fs.list(path)
        if (files.is_empty()) { return "" }
        return files.map((file) -> fs.read(file)).join("\n") + "\n"
    }         
}
