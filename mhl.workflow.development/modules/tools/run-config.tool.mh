export memory RunConfigMemory {type: "json" path: ".mhl/run_config.json" }

export tool RunConfig {

    setup(raw: any) : boolean -> {
        if (!is_object(raw)) {
            log.error("[dev] failed to set up RunConfig: expected an object")
            return false
        }

        var target_dir = raw?.TARGET_DIR
        var verify_cmd = raw?.VERIFY_CMD
        if (target_dir == null || verify_cmd == null) {
            log.error("[dev] failed to set up RunConfig: TARGET_DIR and VERIFY_CMD are required")
            return false
        }

        self.set("target_dir", target_dir)
        self.set("verify_cmd", verify_cmd)
        return true
    }

    get_target_dir() -> self.get("target_dir", null)

    get_verify_cmd() -> self.get("verify_cmd", null)

    // Tunable guards. Harness defaults; override per run via run_config.json "config".
    steps_per_feature() : number -> self.get("steps_per_feature", 6)
    max_replans()       : number -> self.get("max_replans", 2)
    max_features()      : number -> self.get("max_features", 10)
    docs_folder()       : string -> self.get("docs_folder", "specs/active")

    get_config() -> { 
        var config = RunConfigMemory.get("config", null)
        if (config == null) {
            config = {}
            RunConfigMemory.set("config", config)
        }        
        return config
    }

    get(key: string, defaultValue: any) -> {
        return self.get_config()?.[key] ?? defaultValue
    }

    set(key: string, value: any) -> {
        var config = self.get_config()
        config[key] = value
        RunConfigMemory.set("config", config)
    }

    reset() -> RunConfigMemory.set("config", null)
}
