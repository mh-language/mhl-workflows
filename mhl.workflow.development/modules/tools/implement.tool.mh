use {RunConfig as config} from "run-config.tool.mh"

export tool ImplementTool {
    get_feature_context(feature: object) : string -> {
        
        return """
        requirements: ${feature?.implementationContext?.requirements ?? []}
        decisions: ${feature?.implementationContext?.decisions ?? []}
        constraints: ${feature?.implementationContext?.constraints ?? []}
        files: ${feature?.implementationContext?.files ?? []}
        acceptance: ${feature?.implementationContext?.acceptance ?? []}
        """
    }

    get_design_context() : string -> {
        const design_doc_path = config.get_document_candidates("20-software-design-document.md")
            .find((path) -> fs.exists(path))

        if (design_doc_path == null) {
            return "(design document not found)"
        }

        const design_context = fs.read(design_doc_path)

        return design_context
    }

}
