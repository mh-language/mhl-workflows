use {RunConfig as config} from "run-config.tool.mh"

export tool HandoffTool {

    // Append the progress note and commit the feature's work in the target repo.
    // Returns a status token: NO_GIT | NO_CHANGES | COMMIT_FAILED | COMMIT_CREATED <hash>.
    commit_feature(feature: object, verify_result: string) : string -> {
        var target_dir = config.get_target_dir()
        var feature_id = feature.id
        var title = feature.title

        self.append_progress(target_dir, feature_id, title, verify_result)

        // git.status returns exit_code (never raises); non-zero => not a git repo.
        var status = git.status([], target_dir)
        if (status.exit_code != 0) {
            log.warn("[dev] Handoff: ${target_dir} is not a git repository (exit ${status.exit_code}).")
            return "NO_GIT"
        }

        var add = git.add(["."], target_dir)
        if (add.exit_code != 0) {
            log.error("[dev] Handoff: git add failed: ${add.stderr}")
        }

        if (self.nothing_staged(target_dir) == true) {
            log.info("[dev] Handoff: no staged changes for feature ${feature_id}.")
            return "NO_CHANGES"
        }

        var message = "Feature #${feature_id} - ${title}: implementation completed [${verify_result}]"
        var commit = git.commit(message, [], target_dir)
        if (commit.exit_code != 0) {
            log.error("[dev] Handoff: git commit failed: ${commit.stderr}")
            return "COMMIT_FAILED"
        }

        var short_hash = git.rev_parse("HEAD", target_dir)
        log.info("[dev] Handoff: commit ${short_hash} created for feature ${feature_id}.")
        return "COMMIT_CREATED ${short_hash}"
    }

    // Best-effort progress line; a failure here must never block the handoff.
    append_progress(target_dir: string, feature_id, title: string, verify_result: string) -> {
        var line = "[${time.now()}] Feature #${feature_id} - ${title}: implementation completed. Verify with: ${config.get_verify_cmd()}. Result: ${verify_result}"
        try {
            var progress_path = fs.join(target_dir, "progress.txt")
            if (!fs.exists(progress_path)) {
                fs.write(progress_path, "")
            }
            fs.append(progress_path, line + "\n")
        } catch (e) {
            log.error("[dev] Handoff: failed to append to progress.txt: ${e}")
        }
    }

    // True when `git diff --cached` is empty (nothing to commit).
    nothing_staged(target_dir: string) : boolean -> {
        try {
            return git.diff("--cached", target_dir) == ""
        } catch (e) {
            log.warn("[dev] Handoff: git diff --cached failed: ${e}")
            return false
        }
    }
}
