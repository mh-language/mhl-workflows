use { RunConfig as config } from "run-config.tool.mh"

export tool BearingsTool {

    // Bounded repository evidence for a fresh session: target, progress tail, recent git log.
    snapshot() : string -> {
        return "target:\n${config.get_target_dir()}\n\nprogress tail:\n${self.get_progress_file()}\n\nrecent git log:\n${self.get_git_log()}"
    }

    get_progress_file() : string -> {
        const target_dir = config.get_target_dir()
        const progress_path = fs.join(target_dir, "progress.txt")
        var progress = ""

        try {
            if (!fs.exists(progress_path)) {
                progress = "(progress.txt not found)"
                log.warn("[dev] progress.txt not found at ${progress_path}.")
            } else {
                const all_progress = fs.read(progress_path)
                const lines = all_progress.split("\n")
                const start = if (lines.size() > 50) lines.size() - 50 else 0
                var tail = []
                var i = start
                while (i < lines.size()) {
                    tail += [lines[i]]
                    i = i + 1
                }
                progress = tail.join("\n")
                log.info("[dev] progress.txt tail:\n${progress}")
            }
        } catch (e) {
            progress = "(progress unavailable: ${e})"
        }
        return progress
    }

    get_git_log() : string -> {
        try{
            return git.log(10, config.get_target_dir())
        } catch (e) {
            return "(git log unavailable: ${e})"
        }
    }
}
