use { RunConfig as config } from "run-config.tool.mh"

type SmokeResult = {
    success: bool,
    log_path: string
}

export tool SmokeTool {
    execute() : SmokeResult -> {
        const target_dir = config.get_target_dir()
        const script = fs.join(target_dir, "init.sh")

        if (!fs.exists(script)) {
            log.error("[dev] init.sh was not found in ${target_dir}")
            const missing_log = self.write_log(target_dir, script, "init.sh was not found")
            return {success: false, log_path: missing_log}
        }

        try {
            const result = cmd.exec(["bash", script], timeout: 3m)
            const log_path = self.write_log(target_dir, script, result)
            log.info("[dev] Smoke test results: ${log_path}")
            return {success: result.exit_code == 0, log_path: log_path}
        }
        catch (ex) {
            log.error("[dev] Error occurred while executing init.sh: ${ex}")
            const log_path = self.write_log(target_dir, script, ex)
            log.info("[dev] Smoke test results: ${log_path}")
            return {success: false, log_path: log_path}
        }
    }

    write_log(target_dir: string, script: string, result: any) : string -> {
        const log_path = fs.join(target_dir, "logs", "smoke.log")
        const log_content = "cwd: ${target_dir}\nCommand: bash ${script}\nOutput:\n${result}"
        fs.write(log_path, log_content)
        return log_path
    }
}
