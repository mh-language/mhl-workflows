export tool CodexSchemas {
    get_setup_schema_path() -> {
        const schema_path = ".mhl/setup_schema.json"

        if (fs.exists(schema_path)) {
            return schema_path
        }

        fs.write(schema_path, json.stringify({
            "type": "object",
            "properties": {
                "TARGET_DIR": {"type": "string"},
                "VERIFY_CMD": {"type": "string"}
            },
            "required": ["TARGET_DIR", "VERIFY_CMD"],
            "additionalProperties": false
        }))
        
        return schema_path
    }

}
