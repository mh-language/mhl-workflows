use {FeatureStore as store} from "../modules/tools/feature.tool.mh"

test feature_store_rules {
    describe selects_only_features_with_completed_dependencies {
        var context = {
            requirements: [],
            decisions: [],
            constraints: [],
            files: [],
            acceptance: []
        }
        var first = {
            id: 1,
            title: "first",
            priority: 1,
            dependsOn: [],
            description: "first",
            references: [],
            implementationContext: context,
            status: "pending"
        }
        var second = {
            id: 2,
            title: "second",
            priority: 2,
            dependsOn: [1],
            description: "second",
            references: [],
            implementationContext: context,
            status: "pending"
        }

        store.set([first, second])
        are_equal(store.pick_next_feature().id, 1)
        is_true(store.mark_done(1))
        are_equal(store.get()[0].status, "completed")
        are_equal(store.pick_next_feature().id, 2)
        store.reset()
    }

    describe rejects_invalid_graphs_and_preserves_dependency_closure {
        var context = {
            requirements: [],
            decisions: [],
            constraints: [],
            files: [],
            acceptance: []
        }
        var first = {id: 1, title: "first", priority: 3, dependsOn: [], description: "first", references: [], implementationContext: context, status: "pending"}
        var second = {id: 2, title: "second", priority: 2, dependsOn: [1], description: "second", references: [], implementationContext: context, status: "pending"}
        var third = {id: 3, title: "third", priority: 1, dependsOn: [2], description: "third", references: [], implementationContext: context, status: "pending"}

        is_true(store.validate_features([first, second, third]))
        is_false(store.validate_features([first, {id: 2, title: "bad", priority: 2, dependsOn: [9], description: "bad", references: [], implementationContext: context, status: "pending"}]))
        are_equal(store.cap_features([first, second, third], 2), [])
    }
}
